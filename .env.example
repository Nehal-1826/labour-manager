# Supabase configuration template.
# Copy this file to .env and fill in your real values.
# .env is git-ignored and must never be committed.
# Get these from: Supabase Dashboard -> Project Settings -> API

# ---- server (backend) ----
# Project URL, e.g. https://abcdefgh.supabase.co  (root URL, NOT /rest/v1/)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The PUBLISHABLE / anon key (public by design). NEVER put the secret/service-role key here.
SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
# The auth user id (UID) of the single administrator allowed to use the app.
ADMIN_UID=00000000-0000-0000-0000-000000000000

# ---- client (browser bundle; must be VITE_ prefixed to be exposed) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
# Optional: enables a friendly "not the administrator" message at login.
# UX only — the Express backend (ADMIN_UID above) is the real enforcement.
VITE_ADMIN_UID=00000000-0000-0000-0000-000000000000
