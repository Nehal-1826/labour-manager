{
  "name": "labour-management",
  "version": "1.0.0",
  "private": true,
  "description": "Attendance & daily wages calculation system",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "install-all": "npm install",
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "start": "npm run dev"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
